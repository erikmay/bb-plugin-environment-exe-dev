{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "configuration.ts",
    "error-message.ts",
    "providers",
    "test",
    "vitest.config.ts",
    "vitest.live.config.ts"
  ]
}
